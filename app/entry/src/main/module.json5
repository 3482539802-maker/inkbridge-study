{
  "module": {
    "name": "entry", "type": "entry", "description": "$string:module_desc",
    "mainElement": "EntryAbility", "deviceTypes": ["tablet"],
    "deliveryWithInstall": true, "installationFree": false, "pages": "$profile:main_pages",
    "abilities": [{
      "name": "EntryAbility", "srcEntry": "./ets/entryability/EntryAbility.ets",
      "description": "$string:module_desc", "icon": "$media:app_icon", "label": "$string:app_name",
      "startWindowIcon": "$media:app_icon", "startWindowBackground": "$color:start_window_background",
      "exported": true,
      "backgroundModes": ["avPlaybackAndRecord", "audioRecording"],
      "skills": [{"entities":["entity.system.home"],"actions":["ohos.want.action.home"]}]
    }, {
      "name": "NotesProbeAbility", "srcEntry": "./ets/entryability/NotesProbeAbility.ets",
      "startWindowIcon": "$media:app_icon", "startWindowBackground": "$color:start_window_background",
      "exported": true
    }],
    "requestPermissions": [{"name":"ohos.permission.INPUT_MONITORING"},{"name":"ohos.permission.INTERNET"},
      {"name":"ohos.permission.KEEP_BACKGROUND_RUNNING"}]
  }
}
